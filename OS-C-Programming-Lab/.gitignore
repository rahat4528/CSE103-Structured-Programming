# OS C Programming Lab - Git Ignore

# Build artifact directory and executables
build/*
!build/.gitkeep

# Object files and compiler temporaries
*.o
*.obj
*.out
*.exe
*.dSYM/

# Runtime test files generated by file handling programs
class_work/file_handling/*.txt
!class_work/file_handling/sample_input.txt
*.tmp
*.temp

# POSIX shared memory test artefacts
/dev/shm/os_c_*

# Editor & OS temporary files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
